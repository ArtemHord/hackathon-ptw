# Local settings for testing in the simulator.
# Copy this file to ChatUI/Secrets.env (git-ignored) and fill in the values, then run the app again.
# Secrets.env is copied into the app: never commit it and never ship it in a release build.
# Paste each value after "=", with no quotes and no spaces.
# Launch environment variables with the same names win over this file
# (Xcode scheme → Run → Environment, or SIMCTL_CHILD_<NAME> for `xcrun simctl launch`).

# Call Crew backend — the only thing the app needs. Calls, AI answers and the voice come from it.
# Without a token the app shows sample calls; you can also paste the token in Settings → Backend.
CALLCREW_BASE_URL=https://hackathon-ptw-production.up.railway.app
# DEMO_TOKEN from the backend (Railway → Variables)
CALLCREW_DEMO_TOKEN=

# Optional, only without the backend: answers and speech-to-text straight from the phone
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
